# Copy to .env and fill in. Every setting the app reads lives here.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
# Model used for extraction, the RFx co-pilot and the analyst. Must accept images.
OPENAI_MODEL=gpt-5.5

# --- App ---
# Shared password for the hosted link (it spends the API key above).
APP_PASSWORD=change-me
DATA_DIR=data

# --- Normalisation ---
# USD to INR rate used for the comparison. Shown on screen and editable there.
FX_USD_INR=88.0

# --- Hosting on a server with docker compose (leave out locally) ---
# Plain HTTP on the server's IP:        SITE_ADDRESS=:80
# HTTPS without buying a domain:        SITE_ADDRESS=13-234-56-78.sslip.io   (your IP with dashes)
# SITE_ADDRESS=:80
